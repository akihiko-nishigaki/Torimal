<Window x:Class="Torimaru.App.Workspace.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ワークスペース"
        Width="420" Height="620"
        MinWidth="320" MinHeight="300"
        Background="#FFFAFAFA"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12"
        ShowInTaskbar="True"
        Topmost="True">

  <Window.Resources>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FFF2F2F2" />
                <Setter Property="Foreground" Value="#FFAAAAAA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="#FFF7F7F7"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource BarButton}" Click="OnCapture" Content="キャプチャ" />
          <Button Style="{StaticResource BarButton}" Click="OnRefresh" Content="更新" />
          <Button Style="{StaticResource BarButton}" Click="OnOpenFolder" Content="フォルダ" />
        </StackPanel>
        <TextBlock Foreground="#FF888888" FontSize="11" Margin="0,6,0,0"
                   Text="ダブルクリックで編集／他アプリへドラッグで貼り付け" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#FFF7F7F7"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,1,0,0"
            Padding="10,6">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="EditButton" Style="{StaticResource BarButton}" Click="OnEdit" Content="編集" />
        <Button x:Name="CopyButton" Style="{StaticResource BarButton}" Click="OnCopy" Content="コピー" />
        <Button x:Name="DeleteButton" Style="{StaticResource BarButton}" Click="OnDelete" Content="削除" />
      </StackPanel>
    </Border>

    <Grid>
      <ListBox x:Name="Items"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               HorizontalContentAlignment="Stretch"
               SelectionChanged="OnSelectionChanged"
               MouseDoubleClick="OnItemDoubleClick"
               PreviewMouseLeftButtonDown="OnItemsPreviewMouseLeftButtonDown"
               PreviewMouseMove="OnItemsPreviewMouseMove">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="6" Margin="0,2" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Border Width="112" Height="70"
                        Background="#FFEDEDED"
                        BorderBrush="#FFD5D5D5"
                        BorderThickness="1">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Info}" Foreground="#FF888888" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyHint"
                 Text="まだキャプチャがありません。&#x0a;PrintScreen キーで撮れます。"
                 Foreground="#FF999999"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed" />
    </Grid>

  </DockPanel>
</Window>
