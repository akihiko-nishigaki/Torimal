<Window x:Class="Torimaru.App.Editor.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プリセットの名前"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFAFAFA"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">

  <Window.Resources>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FFF2F2F2" />
                <Setter Property="Foreground" Value="#FFAAAAAA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="14">

    <TextBlock x:Name="PromptText"
               TextWrapping="Wrap"
               Foreground="#FF555555"
               Margin="0,0,0,8" />

    <TextBox x:Name="NameBox"
             Height="28"
             MaxLength="24"
             VerticalContentAlignment="Center"
             Padding="4,0"
             TextChanged="OnNameChanged" />

    <TextBlock x:Name="DetailText"
               TextWrapping="Wrap"
               Foreground="#FF888888"
               Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button x:Name="OkButton"
              Style="{StaticResource DialogButton}"
              Click="OnOk"
              Content="OK" />
      <Button Style="{StaticResource DialogButton}"
              Click="OnCancel"
              Content="キャンセル" />
    </StackPanel>

  </StackPanel>
</Window>
