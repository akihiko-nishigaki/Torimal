<Window x:Class="Torimaru.App.Editor.TextResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="読み取り結果"
        Width="620" Height="460"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="#FFFAFAFA"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12">

  <Window.Resources>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="82" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="12">

    <TextBlock x:Name="Summary"
               DockPanel.Dock="Top"
               Foreground="#FF555555"
               Margin="0,0,0,8"
               TextWrapping="Wrap" />

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Style="{StaticResource BarButton}" Click="OnCopy" Content="コピー" />
      <Button Style="{StaticResource BarButton}" Click="OnSaveText" Content="テキスト保存" MinWidth="98" />
      <Button Style="{StaticResource BarButton}" Click="OnClose" Content="閉じる" IsCancel="True" />
    </StackPanel>

    <TextBox x:Name="Body"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             FontFamily="Yu Gothic UI, Consolas"
             FontSize="13"
             Padding="8"
             Background="White"
             BorderBrush="#FFD5D5D5"
             BorderThickness="1" />

  </DockPanel>
</Window>
