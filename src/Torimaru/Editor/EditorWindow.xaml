<Window x:Class="Torimaru.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャプチャの編集"
        Width="1150" Height="800"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFFAFAFA"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

  <Window.Resources>

    <Style x:Key="ToolToggle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF1F6FEB" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1A5FCC" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FFF2F2F2" />
                <Setter Property="Foreground" Value="#FFAAAAAA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Fill" Value="#FFD5D5D5" />
      <Setter Property="Margin" Value="5,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="#FF9E9E9E"
                    BorderThickness="1"
                    CornerRadius="3" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <DockPanel>

    <!-- ツールバー -->
    <Border DockPanel.Dock="Top"
            Background="#FFF7F7F7"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <WrapPanel Orientation="Horizontal">

        <ToggleButton x:Name="ToolSelect" Style="{StaticResource ToolToggle}" Tag="Select"
                      Click="OnToolClick" Content="選択"
                      ToolTip="図形を選んで移動・削除 (V)。文字と吹き出しはダブルクリック（または F2）で書き直せる" />
        <ToggleButton x:Name="ToolArrow" Style="{StaticResource ToolToggle}" Tag="Arrow"
                      Click="OnToolClick" Content="矢印" ToolTip="矢印 (A)" />
        <ToggleButton x:Name="ToolRectangle" Style="{StaticResource ToolToggle}" Tag="Rectangle"
                      Click="OnToolClick" Content="枠" ToolTip="長方形 (R)" />
        <ToggleButton x:Name="ToolEllipse" Style="{StaticResource ToolToggle}" Tag="Ellipse"
                      Click="OnToolClick" Content="楕円" ToolTip="楕円 (E)" />
        <ToggleButton x:Name="ToolText" Style="{StaticResource ToolToggle}" Tag="Text"
                      Click="OnToolClick" Content="文字" ToolTip="テキスト (T)" />
        <ToggleButton x:Name="ToolCallout" Style="{StaticResource ToolToggle}" Tag="Callout"
                      Click="OnToolClick" Content="吹き出し" MinWidth="66"
                      ToolTip="吹き出し (C)。置いたあと選択ツールで○をドラッグすると先端が動く" />
        <ToggleButton x:Name="ToolStep" Style="{StaticResource ToolToggle}" Tag="Step"
                      Click="OnToolClick" Content="番号" ToolTip="番号付きマーカー (S)" />
        <ToggleButton x:Name="ToolHighlight" Style="{StaticResource ToolToggle}" Tag="Highlight"
                      Click="OnToolClick" Content="蛍光" ToolTip="蛍光ペン (H)" />
        <ToggleButton x:Name="ToolBlur" Style="{StaticResource ToolToggle}" Tag="Blur"
                      Click="OnToolClick" Content="ぼかし" ToolTip="機密情報をぼかす (B)" />

        <Rectangle Style="{StaticResource Divider}" />

        <StackPanel x:Name="Palette" Orientation="Horizontal" VerticalAlignment="Center" />

        <Rectangle Style="{StaticResource Divider}" />

        <TextBlock Text="線の太さ" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF555555" />
        <Slider x:Name="ThicknessSlider"
                Width="90"
                Minimum="1" Maximum="20"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                ValueChanged="OnThicknessChanged" />
        <TextBlock x:Name="ThicknessLabel"
                   Width="22"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Foreground="#FF555555" />

        <Rectangle Style="{StaticResource Divider}" />

        <TextBlock Text="文字" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF555555" />
        <ComboBox x:Name="FontFamilyBox"
                  Width="148" Height="26" Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  SelectionChanged="OnFontChanged"
                  ToolTip="文字・吹き出しの書体。選択中の図形にもその場で反映される" />
        <Button x:Name="FavoriteFontButton"
                Style="{StaticResource BarButton}"
                MinWidth="30" Height="26" Margin="0,0,4,0"
                FontSize="14"
                Click="OnToggleFavoriteFont"
                Content="☆"
                ToolTip="この書体をお気に入りに入れる／外す（お気に入りは一覧の先頭に出る）" />
        <ComboBox x:Name="FontSizeBox"
                  Width="62" Height="26"
                  VerticalAlignment="Center"
                  SelectionChanged="OnFontChanged"
                  ToolTip="文字・吹き出しの大きさ（画像ピクセル）" />

        <Rectangle Style="{StaticResource Divider}" />

        <TextBlock Text="吹き出し" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF555555" />
        <ComboBox x:Name="CalloutShapeBox"
                  Width="74" Height="26" Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  SelectedIndex="0"
                  SelectionChanged="OnCalloutLookChanged"
                  ToolTip="吹き出しの形。選択中の吹き出しにもその場で反映される">
          <ComboBoxItem Tag="Round" Content="角丸" />
          <ComboBoxItem Tag="Rect" Content="四角" />
          <ComboBoxItem Tag="Oval" Content="楕円" />
        </ComboBox>
        <ComboBox x:Name="CalloutStyleBox"
                  Width="88" Height="26"
                  VerticalAlignment="Center"
                  SelectedIndex="0"
                  SelectionChanged="OnCalloutLookChanged"
                  ToolTip="吹き出しの地と文字の色。白地・黒地では枠と文字にパレットの色が付く">
          <ComboBoxItem Tag="Solid" Content="色で塗り" />
          <ComboBoxItem Tag="Outline" Content="白地" />
          <ComboBoxItem Tag="Dark" Content="黒地" />
        </ComboBox>

        <Rectangle Style="{StaticResource Divider}" />

        <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Click="OnUndo"
                Content="戻す" ToolTip="元に戻す (Ctrl+Z)" />
        <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Click="OnRedo"
                Content="やり直す" ToolTip="やり直す (Ctrl+Y)" />
        <Button Style="{StaticResource BarButton}" Click="OnDeleteSelected"
                Content="削除" ToolTip="選択中の図形を削除 (Delete)" />

        <Rectangle Style="{StaticResource Divider}" />

        <Button Style="{StaticResource BarButton}" Click="OnCopy"
                Content="コピー" ToolTip="クリップボードへコピー (Ctrl+C)" />
        <Button Style="{StaticResource BarButton}" Click="OnSave"
                Content="保存" ToolTip="上書き保存 (Ctrl+S)" />
        <Button Style="{StaticResource BarButton}" Click="OnSaveAs"
                Content="別名で保存" MinWidth="78" />
        <Button Style="{StaticResource BarButton}" Click="OnOpenFolder"
                Content="フォルダ" ToolTip="保存先フォルダを開く" />

        <Rectangle Style="{StaticResource Divider}" />

        <Button x:Name="OcrButton" Style="{StaticResource BarButton}" Click="OnExtractText"
                Content="文字を抽出" MinWidth="84"
                ToolTip="画像から文字を読み取る（枠を選んでいればその範囲だけ）" />
        <Button Style="{StaticResource BarButton}" Click="OnScanCode"
                Content="QR読取" MinWidth="64"
                ToolTip="QR コード・バーコードを読み取る" />

        <Rectangle Style="{StaticResource Divider}" />

        <Button Style="{StaticResource BarButton}" Click="OnZoomOut" Content="−" MinWidth="30" />
        <Button x:Name="ZoomLabel" Style="{StaticResource BarButton}" Click="OnZoomReset"
                Content="100%" MinWidth="52" ToolTip="クリックで 100%" />
        <Button Style="{StaticResource BarButton}" Click="OnZoomIn" Content="＋" MinWidth="30" />
        <Button Style="{StaticResource BarButton}" Click="OnZoomFit" Content="全体" MinWidth="44" />

      </WrapPanel>
    </Border>

    <!-- ステータスバー -->
    <Border DockPanel.Dock="Bottom"
            Background="#FFF7F7F7"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,1,0,0"
            Padding="10,4">
      <Grid>
        <TextBlock x:Name="StatusText" Foreground="#FF555555" />
        <TextBlock x:Name="PositionText"
                   HorizontalAlignment="Right"
                   Foreground="#FF888888"
                   FontFamily="Consolas" />
      </Grid>
    </Border>

    <!-- キャンバス -->
    <ScrollViewer x:Name="Viewport"
                  Background="#FF3C3C3C"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnViewportMouseWheel">
      <Grid x:Name="CanvasHost"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24"
            MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
            MouseMove="OnCanvasMouseMove"
            MouseLeftButtonUp="OnCanvasMouseLeftButtonUp">

        <!-- ShapeRenderer が作った Canvas を差し込む場所 -->
        <ContentControl x:Name="RenderHost" />

        <!-- 選択枠とテキスト入力。通常は入力を透過させる -->
        <Canvas x:Name="EditOverlay" IsHitTestVisible="False">
          <Rectangle x:Name="SelectionAdorner"
                     Stroke="#FF1F6FEB"
                     StrokeThickness="1.5"
                     StrokeDashArray="4 3"
                     Fill="#141F6FEB"
                     Visibility="Collapsed" />
          <!-- 吹き出しの先端をドラッグするつまみ -->
          <Ellipse x:Name="TailHandle"
                   Width="11" Height="11"
                   Fill="White"
                   Stroke="#FF1F6FEB"
                   StrokeThickness="2"
                   Visibility="Collapsed" />

          <TextBox x:Name="InlineText"
                   Visibility="Collapsed"
                   MinWidth="90"
                   AcceptsReturn="True"
                   AcceptsTab="False"
                   TextWrapping="NoWrap"
                   MaxHeight="420"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="Yu Gothic UI, Segoe UI"
                   FontWeight="Bold"
                   Background="#F2FFFFFF"
                   BorderBrush="#FF1F6FEB"
                   BorderThickness="1"
                   Padding="2,0"
                   LostKeyboardFocus="OnInlineTextLostFocus"
                   PreviewKeyDown="OnInlineTextKeyDown" />
        </Canvas>

      </Grid>
    </ScrollViewer>

  </DockPanel>
</Window>
