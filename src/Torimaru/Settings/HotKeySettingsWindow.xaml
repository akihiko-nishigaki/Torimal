<Window x:Class="Torimaru.App.Settings.HotKeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ショートカットキーの設定"
        Width="660"
        SizeToContent="Height"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#FFFAFAFA"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp">

  <Window.Resources>

    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="MinWidth" Value="74" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEFF5FE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FFF2F2F2" />
                <Setter Property="Foreground" Value="#FFAAAAAA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <DockPanel Margin="16,14,16,12">

    <TextBlock DockPanel.Dock="Top"
               TextWrapping="Wrap"
               Foreground="#FF555555"
               Margin="0,0,0,12">
      <Run Text="「変更」を押してから、使いたいキーを押してください。" />
      <LineBreak />
      <Run Text="Ctrl / Shift / Alt / Win のどれかと組み合わせる必要があります（PrintScreen と F13〜F24 は単独でも使えます）。" />
      <LineBreak />
      <Run Text="他のアプリが使っているキーはその場で弾かれます。変更はすぐ有効になります。" />
    </TextBlock>

    <!-- 操作ごとの行はコードで組み立てる（件数が決まっているため） -->
    <StackPanel x:Name="Rows" DockPanel.Dock="Top" />

    <Border DockPanel.Dock="Bottom"
            Background="#FFFFFFFF"
            BorderBrush="#FFE0E0E0"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,7"
            Margin="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource RowButton}"
                MinWidth="92"
                Click="OnClose"
                Content="閉じる" />
        <TextBlock x:Name="MessageText"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="#FF555555" />
      </DockPanel>
    </Border>

  </DockPanel>
</Window>
