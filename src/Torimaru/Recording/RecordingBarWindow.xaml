<Window x:Class="Torimaru.App.Recording.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="録画中"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="12"
        MouseLeftButtonDown="OnDragBar">

  <Window.Resources>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="#33FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#80FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#F21E1E1E"
          CornerRadius="6"
          BorderBrush="#40FFFFFF"
          BorderThickness="1"
          Padding="12,8">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

      <Ellipse x:Name="RecordingDot"
               Width="11" Height="11"
               Fill="#FFE53935"
               VerticalAlignment="Center" />

      <TextBlock x:Name="ElapsedText"
                 Text="00:00"
                 Foreground="White"
                 FontFamily="Consolas"
                 FontSize="15"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0" />

      <TextBlock x:Name="AudioText"
                 Foreground="#FFAAAAAA"
                 FontSize="11"
                 VerticalAlignment="Center"
                 Margin="10,0,0,0" />

      <Button x:Name="PauseButton" Style="{StaticResource BarButton}"
              Click="OnPauseResume" Content="一時停止" MinWidth="72" />
      <Button Style="{StaticResource BarButton}" Click="OnStop" Content="停止して保存" MinWidth="94" />
      <Button Style="{StaticResource BarButton}" Click="OnCancel" Content="破棄" MinWidth="52" />

    </StackPanel>
  </Border>
</Window>
