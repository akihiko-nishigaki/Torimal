<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows.Media.Ocr（OS 標準・無料の OCR）を使うため Windows SDK の
      射影が付く TFM にしている。Windows 10 2004 以降が必要。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Torimaru.App</RootNamespace>
    <AssemblyName>Torimaru</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Torimaru</AssemblyTitle>
    <Product>Torimaru</Product>
    <Version>0.3.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      WFAC010「高 DPI 設定を app.manifest から削除して ApplicationHighDpiMode を使え」を抑制する。

      これは WinForms 向けの指摘で、このアプリには当てはまらない。
      ApplicationHighDpiMode は ApplicationConfiguration.Initialize() が
      Application.SetHighDpiMode() を呼ぶことで効く仕組みだが、本アプリは
      エントリポイントが App.xaml の WPF アプリで Program.Main を持たず、
      その初期化は決して呼ばれない（＝設定しても無効なまま）。

      一方 app.manifest の PerMonitorV2 は実際に効いている（起動中プロセスの
      GetProcessDpiAwareness が PROCESS_PER_MONITOR_DPI_AWARE を返す）。
      画面キャプチャは座標が物理ピクセルと一致していることが前提なので、
      manifest 側の宣言こそが正しい実装。指摘どおりに消すと座標がずれる。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms が System.Windows.Forms / System.Drawing を暗黙 using に加えるため、
      WPF の System.Windows / System.Windows.Media と Point・Size・Color・Application などが
      全面的に衝突する。参照自体は残したまま暗黙 using だけを外し、
      WinForms / GDI+ の型は使う場所で明示する方針にする。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />

    <!-- 上の Remove で暗黙 using が絞られるため、必要な分は明示的に戻す -->
    <Using Include="System.IO" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Controls" />
    <Using Include="System.Windows.Input" />
    <Using Include="System.Windows.Media" />
    <Using Include="System.Windows.Media.Imaging" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR / バーコードの解読。純マネージドなのでネイティブ DLL は増えない -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Torimaru.Core\Torimaru.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\app.ico" />
  </ItemGroup>

</Project>
